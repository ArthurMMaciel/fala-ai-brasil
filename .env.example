# Copie para .env e preencha. O .env é ignorado pelo Git.

# Gestão de tarefas (uso local do responsável técnico; não usado pelo produto).
CLICKUP_API_TOKEN=

# Supabase (projeto do MVP). Somente valores públicos do cliente aqui.
# Nunca colocar service_role key nem senha do banco neste arquivo.
SUPABASE_PROJECT_REF=
VITE_SUPABASE_URL=
# Na Vercel use VITE_SUPABASE_PUBLISHABLE (o painel recusa o sufixo _KEY); o código aceita os dois.
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SITE_URL=http://127.0.0.1:5173
