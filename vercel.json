{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm test && npm run build",
  "redirects": [
    { "source": "/inicio.html", "destination": "/", "permanent": false },
    { "source": "/404.html", "destination": "/", "permanent": false },
    { "source": "/empresa.html", "destination": "/empresa", "permanent": false },
    { "source": "/parceiros.html", "destination": "/parceiros", "permanent": false },
    { "source": "/intelligence.html", "destination": "/", "permanent": false },
    { "source": "/patrocinio.html", "destination": "/", "permanent": false },
    { "source": "/intelligence", "destination": "/", "permanent": false },
    { "source": "/patrocinio", "destination": "/", "permanent": false }
  ],
  "rewrites": [
    { "source": "/((?!assets/|landing/|brand/|fonts/|sponsors/|media/).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy-Report-Only",
          "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' https: data: blob:; font-src 'self'; media-src 'self'; connect-src 'self' https://nkxfhctqfqroyfmihsns.supabase.co wss://nkxfhctqfqroyfmihsns.supabase.co https://viacep.com.br; object-src 'none'; base-uri 'self'; form-action 'self'"
        }
      ]
    }
  ]
}
